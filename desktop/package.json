{
  "name": "podium-desktop",
  "version": "1.0.0",
  "description": "Podium as a desktop application",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.podium.push",
    "productName": "Podium",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app/dist"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
